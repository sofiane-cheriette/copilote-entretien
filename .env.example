# Clé API Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Votre prénom (utilisé dans le prompt système)
USER_NAME=Votre prénom

# Modèles Gemini Flash à essayer dans l'ordre (bascule automatique)
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Audio : seuil RMS pour détecter la voix (réglez avec le vumètre, typiquement 200–600)
RMS_THRESHOLD=350

# Délai de silence avant de clore un segment (secondes)
SILENCE_SEC=1.0

# Durée minimale de voix pour qu'un segment soit traité (secondes)
MIN_SPEECH_SEC=0.7

# Durée maximale d'un segment (secondes)
MAX_SEGMENT_SEC=25

# Taille de police de la réponse (points)
FONT_SIZE=22

# Nombre de derniers échanges envoyés à l'IA pour le contexte
HISTORY_TURNS=6
